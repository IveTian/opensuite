{
  "name": "@mailflare/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "auth:generate": "npx --yes @better-auth/cli@latest generate --config ./auth.config.ts --output ../../packages/db/src/schema/auth.ts -y",
    "lint": "echo \"(api) no lint\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@mailflare/auth": "workspace:*",
    "@mailflare/db": "workspace:*",
    "@mailflare/shared": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "ical.js": "^2.2.1",
    "pg": "catalog:",
    "postal-mime": "^2.7.5",
    "rrule": "^2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
